digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.45", ranksep="0.56", fontname="Arial", fontsize=18, labelloc="t", label="AI Decision Firewall - Phase 2 Logical Architecture\nRead-only replay; remote alpha.6 design freeze @ 08ce203c; P2-CE-005 CE-0 NOT_EVALUATED", splines=polyline];
  node [shape=plain, fontname="Arial", fontsize=9.5];
  edge [color="#617286", arrowsize=0.68, penwidth=1.05, fontname="Arial", fontsize=8.2];

  control [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#7F95AA">
      <TR><TD COLSPAN="2" BGCOLOR="#DDE7F0"><B>1. Governance, custody, and intake</B></TD></TR>
      <TR>
        <TD BGCOLOR="#EAF2FF"><B>Frozen control bytes</B><BR/>Configuration • manifest<BR/>Model • policy</TD>
        <TD BGCOLOR="#EAF2FF"><B>Origin-aware preflight</B><BR/>Historical: Gate B<BR/>Synthetic: manifest controls</TD>
      </TR>
      <TR>
        <TD BGCOLOR="#EAF2FF"><B>Confined snapshot adapter</B><BR/>Strict schemas • bounded reads<BR/>Path, digest, and count controls</TD>
        <TD PORT="out" BGCOLOR="#EAF2FF"><B>Governance and qualification</B><BR/>FAIL_DATASET or bounded<BR/>QUARANTINE_RECORD</TD>
      </TR>
    </TABLE>
  >];

  decision [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#5E8CC8">
      <TR><TD COLSPAN="2" BGCOLOR="#DCEBFA"><B>2. Deterministic read-only decision path</B></TD></TR>
      <TR>
        <TD PORT="in" BGCOLOR="#DCEBFA"><B>NORMALIZE</B><BR/>Canonical case and temporal order</TD>
        <TD BGCOLOR="#DCEBFA"><B>CONTRACT</B><BR/>Typed/source-authorized signals<BR/>Exact inventory binding</TD>
      </TR>
      <TR>
        <TD BGCOLOR="#E8F1FF"><B>EVIDENCE</B><BR/>Quality and conflict</TD>
        <TD BGCOLOR="#E8F1FF"><B>MODEL</B><BR/>Ordered feature projection</TD>
      </TR>
      <TR>
        <TD BGCOLOR="#E8F1FF"><B>POLICY</B><BR/>Deterministic proposal</TD>
        <TD BGCOLOR="#FFF4DD"><B>VERIFIER</B><BR/>Independent blockers</TD>
      </TR>
      <TR>
        <TD PORT="final" COLSPAN="2" BGCOLOR="#E7F5ED"><B>FINAL_SURFACE</B><BR/>SUPPRESSED_READ_ONLY • counterfactual action only</TD>
      </TR>
      <TR>
        <TD COLSPAN="2" BGCOLOR="#F4F4F4"><FONT COLOR="#555555"><B>Phase 1 compatibility path only:</B> synthetic_simulation authorization → broker → in-memory target<BR/>Not constructed or reachable in Phase 2</FONT></TD>
      </TR>
    </TABLE>
  >];

  subgraph cluster_assurance {
    label="3. Integrity and separately implemented same-process checks";
    color="#8064A2";
    fontcolor="#49335F";
    fontname="Arial";
    fontsize=10;
    style="rounded";
    margin=14;

    audit [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8064A2">
        <TR><TD BGCOLOR="#F0EAF7"><B>Eight-stage audit</B><BR/>Serialized decision and<BR/>boundary binding</TD></TR>
      </TABLE>
    >];

    feature [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8064A2">
        <TR><TD BGCOLOR="#F0EAF7"><B>Reference features</B><BR/>alpha.5 • P2-CE-004 CE-2 SELF<BR/>Version-bound evidence</TD></TR>
      </TABLE>
    >];

    source [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8064A2">
        <TR><TD BGCOLOR="#F7F2FA"><B>Reference EVIDENCE→FINAL</B><BR/>alpha.6 design freeze @ 08ce203c<BR/>CI succeeded • CE-1 only<BR/><FONT COLOR="#6B4A8C">P2-CE-005 CE-0 NOT_EVALUATED</FONT></TD></TR>
      </TABLE>
    >];

    mismatch [shape=box, style="rounded,filled", fillcolor="#FDEBEC", color="#B85450", fontcolor="#8B3A3A", label="FAILED / INCOMPLETE\nPrior files are diagnostics\nNo result claim"];

    {rank=same; audit; feature; source;}
    audit -> feature [label="eight-stage closure"];
    feature -> source [label="exact feature match"];
    audit:s -> mismatch:n [style=dashed, color="#B85450", fontcolor="#8B3A3A", label="mismatch"];
    feature:s -> mismatch:n [style=dashed, color="#B85450", fontcolor="#8B3A3A", label="mismatch"];
    source:s -> mismatch:n [style=dashed, color="#B85450", fontcolor="#8B3A3A", label="mismatch"];
  }

  evidence [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#679B78">
      <TR><TD COLSPAN="3" BGCOLOR="#DFF0E4"><B>4. Post-assurance evaluation and completion</B></TD></TR>
      <TR>
        <TD PORT="receipts" BGCOLOR="#E7F5ED"><B>Assurance receipts</B><BR/>Successful replay only:<BR/>write and freeze both closed<BR/>metadata-only receipts</TD>
        <TD BGCOLOR="#E7F5ED"><B>Deferred evaluation</B><BR/>Adjudication • comparison • metrics</TD>
        <TD BGCOLOR="#E7F5ED"><B>Successful replay completion</B><BR/>Final revalidation passed<BR/>Not P2-CE-005 campaign evidence</TD>
      </TR>
    </TABLE>
  >];

  control:out:s -> decision:in:n;
  decision:final:s -> audit:n [label="serialized decision"];
  source:s -> evidence:receipts:n [label="all five runtime stages match"];
}
