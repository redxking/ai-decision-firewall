digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.55", ranksep="0.7", fontname="Arial", fontsize=18, labelloc="t", label="AI Decision Firewall POC — Decision State Machine"];
  node [shape=ellipse, style="filled", fillcolor="#F5F7FA", color="#536B85", fontname="Arial", fontsize=11];
  edge [color="#617286", fontname="Arial", fontsize=9, arrowsize=0.75];

  start [shape=circle, label="", width=0.22, fillcolor="#243B5A"];
  ingest [shape=box, style="rounded,filled", label="INGEST\nValidate schema"];
  assess [shape=box, style="rounded,filled", label="ASSESS\nEvidence + risk"];
  poison [shape=diamond, label="Poisoned, stale,\nmissing, or conflicting?"];
  low [shape=diamond, label="Risk below\nclosure threshold?"];
  contain [shape=diamond, label="Risk, evidence,\ncriticality permit\nreversible action?"];
  verify [shape=box, style="rounded,filled", label="INDEPENDENT VERIFY"];
  authorize [shape=box, style="rounded,filled", label="AUTHORIZE\nSigned scoped token", fillcolor="#E7F7ED"];
  execute [shape=box, style="rounded,filled", label="SIMULATED EXECUTE"];
  post [shape=box, style="rounded,filled", label="POST-ACTION VERIFY"];
  noaction [shape=doublecircle, label="NO ACTION", fillcolor="#EAF2FF"];
  investigate [shape=doublecircle, label="INVESTIGATE", fillcolor="#FFF4DD"];
  escalate [shape=doublecircle, label="ESCALATE\nHUMAN", fillcolor="#FDE7E9"];
  complete [shape=doublecircle, label="CONTAINED\n+ VERIFIED", fillcolor="#E7F7ED"];

  start -> ingest -> assess -> poison;
  poison -> investigate [label="yes"];
  poison -> low [label="no"];
  low -> noaction [label="yes"];
  low -> contain [label="no"];
  contain -> escalate [label="critical / human-only"];
  contain -> investigate [label="uncertain"];
  contain -> verify [label="eligible"];
  verify -> investigate [label="fail-safe failure"];
  verify -> authorize [label="pass"];
  authorize -> execute -> post;
  post -> complete [label="verified"];
  post -> escalate [label="execution failure"];
}
