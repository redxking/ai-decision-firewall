{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/redxking/ai-decision-firewall/main/contracts/v0.2.0/replay-case.schema.json",
  "title": "AI Decision Firewall Phase 2 Replay Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "opened_at",
    "subject_id",
    "privilege_level",
    "break_glass",
    "asset_id",
    "asset_criticality",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "case_id": { "$ref": "#/$defs/identifier" },
    "opened_at": { "type": "string", "format": "date-time" },
    "subject_id": { "$ref": "#/$defs/identifier" },
    "privilege_level": { "$ref": "#/$defs/identifier" },
    "break_glass": { "type": "boolean" },
    "asset_id": { "$ref": "#/$defs/identifier" },
    "asset_criticality": { "type": "number", "minimum": 0, "maximum": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/evidence_event" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "evidence_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "case_id",
        "source_type",
        "source_instance",
        "observed_at",
        "collected_at",
        "integrity",
        "provenance_id",
        "trust_score",
        "entity_refs",
        "attributes",
        "untrusted_text",
        "contains_instructional_content"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "case_id": { "$ref": "#/$defs/identifier" },
        "source_type": { "$ref": "#/$defs/identifier" },
        "source_instance": { "$ref": "#/$defs/identifier" },
        "observed_at": { "type": "string", "format": "date-time" },
        "collected_at": { "type": "string", "format": "date-time" },
        "integrity": { "enum": ["verified", "unverified", "failed"] },
        "provenance_id": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "trust_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "entity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "attributes": { "$ref": "#/$defs/event_attributes" },
        "untrusted_text": { "type": "string", "maxLength": 16384 },
        "contains_instructional_content": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source_type": { "const": "asset_inventory" } }
          },
          "then": {
            "properties": {
              "attributes": {
                "required": [
                  "asset_id",
                  "privilege_level",
                  "break_glass",
                  "asset_criticality"
                ],
                "properties": {
                  "asset_id": { "$ref": "#/$defs/identifier" },
                  "privilege_level": { "$ref": "#/$defs/identifier" },
                  "break_glass": { "type": "boolean" },
                  "asset_criticality": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": {
                "anyOf": [
                  { "required": ["failed_logins"] },
                  { "required": ["new_device"] },
                  { "required": ["impossible_travel"] },
                  { "required": ["mfa_fatigue"] },
                  { "required": ["token_reuse"] },
                  { "required": ["after_hours"] },
                  { "required": ["strong_mfa"] },
                  { "required": ["oauth_grant"] }
                ]
              }
            }
          },
          "then": {
            "properties": { "source_type": { "const": "identity" } }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": {
                "anyOf": [
                  { "required": ["credential_dumping"] },
                  { "required": ["unusual_admin_action"] },
                  { "required": ["edr_malware"] },
                  { "required": ["device_noncompliant"] }
                ]
              }
            }
          },
          "then": {
            "properties": { "source_type": { "const": "endpoint" } }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": {
                "anyOf": [
                  { "required": ["lateral_movement"] },
                  { "required": ["known_vpn"] }
                ]
              }
            }
          },
          "then": {
            "properties": { "source_type": { "const": "network" } }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": { "required": ["threat_ip"] }
            }
          },
          "then": {
            "properties": {
              "source_type": { "enum": ["network", "threat_intel"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": {
                "anyOf": [
                  { "required": ["maintenance_window"] },
                  { "required": ["service_account_baseline"] }
                ]
              }
            }
          },
          "then": {
            "properties": { "source_type": { "const": "change_management" } }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": { "required": ["approved_travel"] }
            }
          },
          "then": {
            "properties": { "source_type": { "const": "user_context" } }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": { "required": ["source_conflict"] }
            }
          },
          "then": {
            "properties": { "source_type": { "const": "network" } }
          }
        }
      ]
    },
    "event_attributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "failed_logins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "new_device": { "type": "boolean" },
        "impossible_travel": { "type": "boolean" },
        "threat_ip": { "type": "boolean" },
        "mfa_fatigue": { "type": "boolean" },
        "token_reuse": { "type": "boolean" },
        "credential_dumping": { "type": "boolean" },
        "lateral_movement": { "type": "boolean" },
        "unusual_admin_action": { "type": "boolean" },
        "edr_malware": { "type": "boolean" },
        "after_hours": { "type": "boolean" },
        "known_vpn": { "type": "boolean" },
        "approved_travel": { "type": "boolean" },
        "maintenance_window": { "type": "boolean" },
        "service_account_baseline": { "type": "boolean" },
        "strong_mfa": { "type": "boolean" },
        "device_noncompliant": { "type": "boolean" },
        "oauth_grant": { "type": "boolean" },
        "source_conflict": { "type": "boolean" }
      }
    }
  }
}
