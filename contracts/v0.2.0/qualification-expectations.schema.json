{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/redxking/ai-decision-firewall/main/contracts/v0.2.0/qualification-expectations.schema.json",
  "title": "AI Decision Firewall Phase 2 Synthetic Qualification Expectations",
  "description": "Closed, metadata-only expected outcomes for a predeclared synthetic record-qualification campaign. Source payloads, parsed values, payload identifiers, exception text, and free-form messages are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "source_role",
    "source_file_sha256",
    "expected_totals",
    "records"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "dataset_id": { "$ref": "#/$defs/identifier" },
    "source_role": { "const": "cases" },
    "source_file_sha256": { "$ref": "#/$defs/sha256" },
    "expected_totals": { "$ref": "#/$defs/expectedTotals" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/expectedRecord" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "expectedTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_line_count",
        "nonblank_record_count",
        "accepted_count",
        "quarantined_count",
        "fatal_count"
      ],
      "properties": {
        "physical_line_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "nonblank_record_count": { "$ref": "#/$defs/boundedCount" },
        "accepted_count": { "$ref": "#/$defs/boundedCount" },
        "quarantined_count": { "$ref": "#/$defs/boundedCount" },
        "fatal_count": { "const": 0 }
      }
    },
    "expectedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonblank_record_number",
        "raw_line_sha256",
        "status",
        "error_category",
        "error_code"
      ],
      "properties": {
        "nonblank_record_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "raw_line_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["ACCEPTED", "QUARANTINED"] },
        "error_category": {
          "type": "string",
          "maxLength": 32
        },
        "error_code": {
          "type": "string",
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "ACCEPTED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "error_category": { "const": "" },
              "error_code": { "const": "" }
            }
          },
          "else": {
            "oneOf": [
              {
                "properties": {
                  "error_category": { "const": "RESOURCE_LIMIT" },
                  "error_code": {
                    "enum": [
                      "EVENT_COUNT_EXCEEDED",
                      "UNTRUSTED_TEXT_TOO_LONG",
                      "ATTRIBUTES_TOO_LARGE"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "error_category": { "const": "SYNTAX" },
                  "error_code": { "enum": ["INVALID_JSON"] }
                }
              },
              {
                "properties": {
                  "error_category": { "const": "STRUCTURE" },
                  "error_code": {
                    "enum": [
                      "RECORD_NOT_OBJECT",
                      "MISSING_REQUIRED_FIELD",
                      "UNEXPECTED_FIELD"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "error_category": { "const": "SEMANTICS" },
                  "error_code": {
                    "enum": [
                      "INVALID_IDENTIFIER",
                      "INVALID_TIMESTAMP",
                      "INVALID_BOOLEAN",
                      "INVALID_TYPE",
                      "INVALID_ENUM_VALUE",
                      "EMPTY_REQUIRED_COLLECTION",
                      "NUMERIC_OUT_OF_RANGE",
                      "CASE_EVENT_ID_MISMATCH",
                      "EVENT_TIME_ORDER_INVALID",
                      "DUPLICATE_ENTITY_REFERENCE",
                      "UNAUTHORIZED_MODELED_SIGNAL",
                      "UNAUTHORIZED_DECISION_SIGNAL",
                      "CANONICAL_CONTEXT_MISSING",
                      "CANONICAL_CONTEXT_MISMATCH"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
