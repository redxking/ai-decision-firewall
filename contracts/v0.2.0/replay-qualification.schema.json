{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/redxking/ai-decision-firewall/main/contracts/v0.2.0/replay-qualification.schema.json",
  "title": "AI Decision Firewall Phase 2 Replay Record Qualification",
  "description": "Metadata-only qualification-ledger record for one nonblank source record. The contract intentionally permits no source payload, parsed payload, identifier extracted from the payload, exception text, or free-form rejection message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_run_id",
    "dataset_id",
    "source_role",
    "source_file_sha256",
    "physical_line_number",
    "nonblank_record_number",
    "raw_line_sha256",
    "status",
    "error_category",
    "error_code"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "qualification_run_id": { "$ref": "#/$defs/identifier" },
    "dataset_id": { "$ref": "#/$defs/identifier" },
    "source_role": { "const": "cases" },
    "source_file_sha256": { "$ref": "#/$defs/sha256" },
    "physical_line_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "nonblank_record_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "raw_line_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["ACCEPTED", "QUARANTINED"] },
    "error_category": {
      "type": "string",
      "maxLength": 32
    },
    "error_code": {
      "type": "string",
      "maxLength": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ACCEPTED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error_category": { "const": "" },
          "error_code": { "const": "" }
        }
      },
      "else": {
        "oneOf": [
          {
            "properties": {
              "error_category": { "const": "RESOURCE_LIMIT" },
              "error_code": {
                "enum": [
                  "EVENT_COUNT_EXCEEDED",
                  "UNTRUSTED_TEXT_TOO_LONG",
                  "ATTRIBUTES_TOO_LARGE"
                ]
              }
            }
          },
          {
            "properties": {
              "error_category": { "const": "SYNTAX" },
              "error_code": { "enum": ["INVALID_JSON"] }
            }
          },
          {
            "properties": {
              "error_category": { "const": "STRUCTURE" },
              "error_code": {
                "enum": [
                  "RECORD_NOT_OBJECT",
                  "MISSING_REQUIRED_FIELD",
                  "UNEXPECTED_FIELD"
                ]
              }
            }
          },
          {
            "properties": {
              "error_category": { "const": "SEMANTICS" },
              "error_code": {
                "enum": [
                  "INVALID_IDENTIFIER",
                  "INVALID_TIMESTAMP",
                  "INVALID_BOOLEAN",
                  "INVALID_TYPE",
                  "INVALID_ENUM_VALUE",
                  "EMPTY_REQUIRED_COLLECTION",
                  "NUMERIC_OUT_OF_RANGE",
                  "CASE_EVENT_ID_MISMATCH",
                  "EVENT_TIME_ORDER_INVALID",
                  "DUPLICATE_ENTITY_REFERENCE",
                  "UNAUTHORIZED_MODELED_SIGNAL",
                  "UNAUTHORIZED_DECISION_SIGNAL",
                  "CANONICAL_CONTEXT_MISSING",
                  "CANONICAL_CONTEXT_MISMATCH"
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
